{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Main window and popped-out log / shell windows",
  "windows": [
    "main",
    "term-*"
  ],
  "permissions": [
    "core:default",
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        {
          "url": "http://localhost:*"
        }
      ]
    }
  ]
}
